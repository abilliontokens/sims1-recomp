/assets/
/assets/movies_4k/
*.iso
*.xbe

# downloaded media tools; tools/upscale_movies.py itself stays tracked
/tools/bin/

# locally installed build toolchain
/.toolchain/

# runtime files
settings.toml
shadercache/
/logs/
/hdd/
/CrashDumps/

# editors
.vs/
.vscode/
.idea/

# Local temporary folder
.local
__pycache__/

# Release artifacts: built by release.sh / release.bat, attached to a GitHub
# release, never committed.
/Sims1-linux-x64.tar.zst
/Sims1-win64.zip

# F3 frame captures (game-rendered, derived from the disc)
/cap/
